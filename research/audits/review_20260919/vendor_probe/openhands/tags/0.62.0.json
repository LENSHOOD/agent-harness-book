ands for this user\n       - WORKSPACE_MOUNT_PATH=${WORKSPACE_BASE:-$PWD/workspace}\n     ports:"},{"sha":"571d7950d1baf7318e8284458de39bbe5c226a04","filename":"frontend/package-lock.json","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/OpenHands/OpenHands/blob/7fbb48c40679afd674970966b96185657d92a487/frontend%2Fpackage-lock.json","raw_url":"https://github.com/OpenHands/OpenHands/raw/7fbb48c40679afd674970966b96185657d92a487/frontend%2Fpackage-lock.json","contents_url":"https://api.github.com/repos/OpenHands/OpenHands/contents/frontend%2Fpackage-lock.json?ref=7fbb48c40679afd674970966b96185657d92a487","patch":"@@ -1,12 +1,12 @@\n {\n   \"name\": \"openhands-frontend\",\n-  \"version\": \"0.61.0\",\n+  \"version\": \"0.62.0\",\n   \"lockfileVersion\": 3,\n   \"requires\": true,\n   \"packages\": {\n     \"\": {\n       \"name\": \"openhands-frontend\",\n-      \"version\": \"0.61.0\",\n+      \"version\": \"0.62.0\",\n       \"dependencies\": {\n         \"@heroui/react\": \"^2.8.4\",\n         \"@heroui/use-infinite-scroll\": \"^2.2.11\","},{"sha":"de5dd136aea7a11251c779519866d71d96f126e9","filename":"frontend/package.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/OpenHands/OpenHands/blob/7fbb48c40679afd674970966b96185657d92a487/frontend%2Fpackage.json","raw_url":"https://github.com/OpenHands/OpenHands/raw/7fbb48c40679afd674970966b96185657d92a487/frontend%2Fpackage.json","contents_url":"https://api.github.com/repos/OpenHands/OpenHands/contents/frontend%2Fpackage.json?ref=7fbb48c40679afd674970966b96185657d92a487","patch":"@@ -1,6 +1,6 @@\n {\n   \"name\": \"openhands-frontend\",\n-  \"version\": \"0.61.0\",\n+  \"version\": \"0.62.0\",\n   \"private\": true,\n   \"type\": \"module\",\n   \"engines\": {"},{"sha":"d16247389da0c7d9dda0c5896569ef77335517ff","filename":"openhands/runtime/impl/kubernetes/README.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url